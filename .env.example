# ============================================================
# ERP Portal — Environment Variables Template
# Copy this file to .env (git-ignored) and populate appropriate values.
# NEVER commit populated credentials or production secrets to source control.
# ============================================================

# ------------------------------------------------------------
# Environment & Active Profile
# Supported values: local, test, staging, prod
# ------------------------------------------------------------
ENVIRONMENT=local
SPRING_PROFILES_ACTIVE=local

# ------------------------------------------------------------
# Backend Server Configuration
# ------------------------------------------------------------
SERVER_PORT=8080
AUTH_SESSION_TTL_SECONDS=1800
STUDENT_DOCUMENT_STORAGE_DIR=/var/erp/storage/student-documents
SWAGGER_ENABLED=true

# ------------------------------------------------------------
# Database Connection (MySQL 8.0)
# In production, use managed Aurora / Cloud SQL / RDS endpoint
# ------------------------------------------------------------
DB_URL=jdbc:mysql://localhost:3306/erp_portal_db?serverTimezone=UTC&characterEncoding=UTF-8
DB_USERNAME=erp_user
DB_PASSWORD=replace_with_secure_password
DB_ROOT_PASSWORD=replace_with_secure_root_password
FLYWAY_ENABLED=true
DB_POOL_MAX_SIZE=20
DB_POOL_MIN_IDLE=5

# ------------------------------------------------------------
# Security & CORS
# In production, specify exact origin domains (comma-separated, NO localhost)
# ------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# ------------------------------------------------------------
# Frontend Configuration (Vite)
# ------------------------------------------------------------
VITE_API_BASE_URL=
VITE_DEV_API_PROXY_TARGET=http://localhost:8080

# ------------------------------------------------------------
# Observability & Monitoring
# ------------------------------------------------------------
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=INFO
MANAGEMENT_HEALTH_SHOW_DETAILS=when_authorized
