{
  "info": {
    "name": "ERP Academic Module",
    "description": "API verification for academic setup, assignments, timetable conflicts, homework scope, and syllabus progress. Configure baseUrl, administrator token, teacher token, teacher-linked staffId, and unique codes in a Postman environment.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" }, { "key": "token", "value": "" }, { "key": "teacherToken", "value": "" },
    { "key": "sessionId", "value": "" }, { "key": "classId", "value": "" }, { "key": "sectionId", "value": "" }, { "key": "subjectId", "value": "" },
    { "key": "staffId", "value": "" }, { "key": "teacherAssignmentId", "value": "" }, { "key": "timetableId", "value": "" }, { "key": "homeworkId", "value": "" }, { "key": "syllabusId", "value": "" }
  ],
  "item": [
    { "name": "Create academic session", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"code\": \"{{sessionCode}}\",\n  \"name\": \"Academic Test Session\",\n  \"startDate\": \"2026-04-01\",\n  \"endDate\": \"2027-03-31\",\n  \"active\": true\n}" }, "url": "{{baseUrl}}/api/v1/academics/sessions" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('Session created', () => pm.response.to.have.status(201));", "if (pm.response.code === 201) pm.collectionVariables.set('sessionId', pm.response.json().id);"] } }] },
    { "name": "Create class", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"{{className}}\",\n  \"orderSeq\": 1\n}" }, "url": "{{baseUrl}}/api/v1/academics/classes" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('Class created', () => pm.response.to.have.status(201));", "if (pm.response.code === 201) pm.collectionVariables.set('classId', pm.response.json().id);"] } }] },
    { "name": "Create section", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"classId\": {{classId}},\n  \"name\": \"A\",\n  \"capacity\": 30,\n  \"roomNo\": \"101\"\n}" }, "url": "{{baseUrl}}/api/v1/academics/sections" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('Section created', () => pm.response.to.have.status(201));", "if (pm.response.code === 201) pm.collectionVariables.set('sectionId', pm.response.json().id);"] } }] },
    { "name": "Duplicate section in same class returns conflict", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"classId\": {{classId}},\n  \"name\": \"A\"\n}" }, "url": "{{baseUrl}}/api/v1/academics/sections" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('Duplicate class/section rejected', () => pm.response.to.have.status(409));"] } }] },
    { "name": "Create subject", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"code\": \"{{subjectCode}}\",\n  \"name\": \"Academic Test Subject\"\n}" }, "url": "{{baseUrl}}/api/v1/academics/subjects" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('Subject created', () => pm.response.to.have.status(201));", "if (pm.response.code === 201) pm.collectionVariables.set('subjectId', pm.response.json().id);"] } }] },
    { "name": "Assign subject to class and session", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"sessionId\": {{sessionId}},\n  \"classId\": {{classId}},\n  \"subjectId\": {{subjectId}},\n  \"active\": true\n}" }, "url": "{{baseUrl}}/api/v1/academics/class-subjects" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('Class subject assigned', () => pm.response.to.have.status(201));"] } }] },
    { "name": "Assign teacher", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"sessionId\": {{sessionId}},\n  \"sectionId\": {{sectionId}},\n  \"subjectId\": {{subjectId}},\n  \"staffId\": {{staffId}}\n}" }, "url": "{{baseUrl}}/api/v1/academics/teacher-assignments" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('Teacher assigned', () => pm.response.to.have.status(201));", "if (pm.response.code === 201) pm.collectionVariables.set('teacherAssignmentId', pm.response.json().id);"] } }] },
    { "name": "Create timetable period", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"sessionId\": {{sessionId}},\n  \"classId\": {{classId}},\n  \"sectionId\": {{sectionId}},\n  \"subjectId\": {{subjectId}},\n  \"teacherId\": {{staffId}},\n  \"dayOfWeek\": 1,\n  \"startTime\": \"09:00:00\",\n  \"endTime\": \"09:45:00\",\n  \"roomNo\": \"101\"\n}" }, "url": "{{baseUrl}}/api/v1/academics/timetable" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('Timetable period created', () => pm.response.to.have.status(201));", "if (pm.response.code === 201) pm.collectionVariables.set('timetableId', pm.response.json().id);"] } }] },
    { "name": "Overlapping section period returns conflict", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"sessionId\": {{sessionId}},\n  \"classId\": {{classId}},\n  \"sectionId\": {{sectionId}},\n  \"subjectId\": {{subjectId}},\n  \"teacherId\": {{staffId}},\n  \"dayOfWeek\": 1,\n  \"startTime\": \"09:15:00\",\n  \"endTime\": \"10:00:00\"\n}" }, "url": "{{baseUrl}}/api/v1/academics/timetable" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('Overlapping schedule rejected', () => pm.response.to.have.status(409));"] } }] },
    { "name": "Teacher cannot create homework for an unassigned scope", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{teacherToken}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"sessionId\": {{sessionId}},\n  \"sectionId\": {{sectionId}},\n  \"subjectId\": {{subjectId}},\n  \"title\": \"Scope check\",\n  \"dueDate\": \"2026-10-30\"\n}" }, "url": "{{baseUrl}}/api/v1/academics/homework" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('Teacher scope enforced', () => pm.response.to.have.status(403));"] } }] },
    { "name": "Create syllabus progress as assigned teacher", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{teacherToken}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"sessionId\": {{sessionId}},\n  \"sectionId\": {{sectionId}},\n  \"subjectId\": {{subjectId}},\n  \"topic\": \"Progress verification\",\n  \"status\": \"IN_PROGRESS\"\n}" }, "url": "{{baseUrl}}/api/v1/academics/syllabus" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('Syllabus progress recorded for assigned teacher', () => pm.response.to.have.status(201));", "if (pm.response.code === 201) pm.collectionVariables.set('syllabusId', pm.response.json().id);"] } }] },
    { "name": "Unauthenticated academic request returns 401", "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/academics/sessions" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('Unauthenticated request denied', () => pm.response.to.have.status(401));"] } }] }
  ]
}
