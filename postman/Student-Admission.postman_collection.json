{
  "info": {
    "name": "ERP Student and Admission Module",
    "description": "Module API verification. Provide baseUrl, username, password, and a valid small PDF/JPEG/PNG path in a Postman environment. Requests run in order and save returned identifiers.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "username", "value": "" },
    { "key": "password", "value": "" },
    { "key": "token", "value": "" },
    { "key": "studentId", "value": "" },
    { "key": "secondStudentId", "value": "" },
    { "key": "guardianId", "value": "" },
    { "key": "documentId", "value": "" },
    { "key": "admissionId", "value": "" },
    { "key": "applicationNo", "value": "" },
    { "key": "admissionNo", "value": "" },
    { "key": "uploadPath", "value": "" }
  ],
  "item": [
    {
      "name": "Login",
      "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}" }, "url": "{{baseUrl}}/api/v1/auth/login" },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('Login successful', () => pm.response.to.have.status(200));", "if (pm.response.code === 200) pm.collectionVariables.set('token', pm.response.json().accessToken);"] } }]
    },
    {
      "name": "Student list: search, filter, sort allow-list, pagination",
      "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/api/v1/students?search=&status=ACTIVE&sortBy=admissionDate&direction=DESC&page=0&size=10" },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('List succeeds with a page envelope', () => { pm.response.to.have.status(200); pm.expect(pm.response.json()).to.have.property('content'); });"] } }]
    },
    {
      "name": "Create student (active profile)",
      "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"admissionNo\": \"{{admissionNo}}\",\n  \"firstName\": \"Postman\",\n  \"lastName\": \"Student\"\n}" }, "url": "{{baseUrl}}/api/v1/students" },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('Created and returns profile', () => { pm.response.to.have.status(201); pm.expect(pm.response.json().admissionNo).to.eql(pm.collectionVariables.get('admissionNo')); });", "if (pm.response.code === 201) pm.collectionVariables.set('studentId', pm.response.json().id);"] } }]
    },
    {
      "name": "Duplicate admission number returns conflict",
      "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"admissionNo\": \"{{admissionNo}}\",\n  \"firstName\": \"Duplicate\"\n}" }, "url": "{{baseUrl}}/api/v1/students" },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('Duplicate admission number rejected', () => pm.response.to.have.status(409));"] } }]
    },
    {
      "name": "Invalid student validation",
      "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"admissionNo\": \"\",\n  \"firstName\": \"\"\n}" }, "url": "{{baseUrl}}/api/v1/students" },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('Invalid request rejected', () => pm.response.to.have.status(400));"] } }]
    },
    {
      "name": "Read and update student",
      "item": [
        { "name": "Read detail", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/api/v1/students/{{studentId}}" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('Student detail is readable', () => pm.response.to.have.status(200));"] } }] },
        { "name": "Update profile", "request": { "method": "PUT", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"firstName\": \"Postman Updated\",\n  \"lastName\": \"Student\"\n}" }, "url": "{{baseUrl}}/api/v1/students/{{studentId}}" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('Student update succeeds', () => pm.response.to.have.status(200));"] } }] }
      ]
    },
    {
      "name": "Guardians",
      "item": [
        { "name": "Add guardian", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"Sample Guardian\",\n  \"relation\": \"Parent\",\n  \"phone\": \"9000000000\",\n  \"primary\": true\n}" }, "url": "{{baseUrl}}/api/v1/students/{{studentId}}/guardians" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('Guardian linked', () => pm.response.to.have.status(200));", "if (pm.response.code === 200) pm.collectionVariables.set('guardianId', pm.response.json()[0].id);"] } }] },
        { "name": "Remove guardian link", "request": { "method": "DELETE", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/api/v1/students/{{studentId}}/guardians/{{guardianId}}" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('Guardian unlinked', () => pm.response.to.have.status(204));"] } }] }
      ]
    },
    {
      "name": "Admission workflow",
      "item": [
        { "name": "Create draft", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"applicationNo\": \"{{applicationNo}}\",\n  \"student\": {\n    \"admissionNo\": \"{{admissionNo}}-APP\",\n    \"firstName\": \"Applicant\",\n    \"lastName\": \"Example\"\n  }\n}" }, "url": "{{baseUrl}}/api/v1/admissions" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('Draft created', () => pm.response.to.have.status(201));", "if (pm.response.code === 201) { pm.collectionVariables.set('admissionId', pm.response.json().id); pm.collectionVariables.set('secondStudentId', pm.response.json().studentId); }"] } }] },
        { "name": "Upload birth certificate (configure uploadPath)", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "body": { "mode": "formdata", "formdata": [{ "key": "docType", "value": "BIRTH_CERT", "type": "text" }, { "key": "file", "type": "file", "src": "{{uploadPath}}" }] }, "url": "{{baseUrl}}/api/v1/students/{{secondStudentId}}/documents" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('Birth certificate upload accepted', () => pm.response.to.have.status(201));"] } }] },
        { "name": "Submit draft", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/api/v1/admissions/{{admissionId}}/submit" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('Application submitted', () => pm.response.to.have.status(200));"] } }] },
        { "name": "Approve application", "request": { "method": "PATCH", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"status\": \"APPROVED\",\n  \"note\": \"Postman module verification\"\n}" }, "url": "{{baseUrl}}/api/v1/admissions/{{admissionId}}/status" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('Application approved', () => pm.response.to.have.status(200));"] } }] }
      ]
    },
    {
      "name": "Student history and transfer",
      "item": [
        { "name": "Read history", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/api/v1/students/{{studentId}}/history" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('History is returned', () => pm.response.to.have.status(200));"] } }] },
        { "name": "Transfer active student", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"destinationSchool\": \"Other School\",\n  \"effectiveDate\": \"2026-09-30\",\n  \"reason\": \"Transfer test\"\n}" }, "url": "{{baseUrl}}/api/v1/students/{{studentId}}/transfer" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('Transfer recorded', () => pm.response.to.have.status(200));"] } }] }
      ]
    },
    {
      "name": "Authorization: missing token receives 401",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/students" },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('Unauthenticated request is rejected', () => pm.response.to.have.status(401));"] } }]
    }
  ]
}
